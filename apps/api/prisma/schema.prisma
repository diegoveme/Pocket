// Pocket relational data model (off-chain state).
// Enum values mirror @pocket/shared and are stored as-is: never rename one.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Supabase pooled connection (Supavisor, port 6543) used by the app.
  url       = env("DATABASE_URL")
  // Supabase direct connection (port 5432) used by Prisma Migrate.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

enum UserRole {
  startup
  specialist
  manager
}

enum VerificationStatus {
  not_submitted
  pending
  approved
  rejected
}

// A user IS their Stellar wallet: they sign in by signing a challenge with it
// and the same address takes their role in every escrow they join.
model User {
  id                 String             @id @default(uuid()) @db.Uuid
  stellarAddress     String             @unique @map("stellar_address")
  role               UserRole
  verificationStatus VerificationStatus @default(not_submitted) @map("verification_status")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  verificationRequests  VerificationRequest[] @relation("VerificationRequests")
  verificationsReviewed VerificationRequest[] @relation("VerificationReviews")

  @@map("users")
}

// One outstanding SEP-10 style login challenge per address. The row is replaced
// on every new challenge and deleted once a login succeeds.
model AuthChallenge {
  id             String   @id @default(uuid()) @db.Uuid
  stellarAddress String   @unique @map("stellar_address")
  nonce          String
  expiresAt      DateTime @map("expires_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("auth_challenges")
}

// ---------------------------------------------------------------------------
// Verification (manual KYC/KYB reviewed by a manager)
// ---------------------------------------------------------------------------

// One request per submission. A user keeps their history: the newest row is the
// one that decides their current verification status.
model VerificationRequest {
  id                    String             @id @default(uuid()) @db.Uuid
  userId                String             @map("user_id") @db.Uuid
  status                VerificationStatus @default(pending)
  fullName              String             @map("full_name")
  contactEmail          String             @map("contact_email")
  // ISO 3166-1 alpha-2 country code.
  country               String             @db.Char(2)
  linkedinUrl           String?            @map("linkedin_url")
  websiteUrl            String?            @map("website_url")
  // Startups only.
  companyName           String?            @map("company_name")
  companyRegistrationId String?            @map("company_registration_id")
  note                  String?
  // Filled in by the manager who reviewed it.
  reviewNote            String?            @map("review_note")
  reviewedById          String?            @map("reviewed_by") @db.Uuid
  reviewedAt            DateTime?          @map("reviewed_at")
  submittedAt           DateTime           @default(now()) @map("submitted_at")

  user       User  @relation("VerificationRequests", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("VerificationReviews", fields: [reviewedById], references: [id])

  @@index([userId])
  @@index([status])
  @@map("verification_requests")
}
