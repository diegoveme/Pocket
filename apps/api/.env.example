# Server
PORT=3000
# Comma-separated list of allowed web origins
CORS_ORIGINS=http://localhost:3001

# Database (see docker-compose.yml at the repo root)
DATABASE_URL=postgresql://pocket:pocket@localhost:5433/pocket?schema=public

# Auth
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Stellar: testnet | mainnet
STELLAR_NETWORK=testnet
